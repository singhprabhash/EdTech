# Public release is OFF by default. Use only a verified, owned HTTPS production origin.
AEETDS_SITE_URL=
AEETDS_PUBLIC_RELEASE=false
# Local verification only: HTTP allowed solely for localhost/127.0.0.1, never public hosting.
AEETDS_ALLOW_LOCAL_HTTP=false

# Chosen deployment: self-hosted Node24, one persistent PRIVATE disk/SQLite.
# Absolute path OUTSIDE this checkout/web root; owner-only permissions.
AEETDS_DATA_DIR=
# At least 32 random secret characters, server-only. Back up separately and rotate carefully.
AEETDS_APP_SECRET=
AEETDS_SUBMISSIONS_ENABLED=false
# Set true only behind a trusted proxy that strips/replaces client X-Forwarded-For.
AEETDS_TRUST_PROXY=false

# Authenticated SMTP; 465 uses TLS, 587 requires STARTTLS. Validated single sender mailbox.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# All notifications target secretaryaeetds@gmail.com (fixed in server code).

# Configure an invisible Cloudflare Turnstile widget for the exact site hostname.
# Site key is intentionally public; secret is server-only. No test bypass in production code.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Absolute path to installed clamdscan, with current definitions. Upload forms fail closed without it.
AEETDS_CLAMDSCAN_PATH=

# Generate using npm run admin:password from a private stdin prompt/secret manager.
# Never place an actual password here; hash changes invalidate existing sessions.
AEETDS_ADMIN_PASSWORD_HASH=
# Separate private backup destination/volume, outside live data and checkout.
AEETDS_BACKUP_DIR=

# No analytics or social-image asset configured. See docs/AEETDS_GUIDE_OPERATIONS.md.
